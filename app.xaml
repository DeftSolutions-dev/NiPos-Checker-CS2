<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="NiposChecker.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NiposChecker">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.xaml" />
        <ResourceDictionary Source="Themes/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:Base64ToImageConverter x:Key="Base64ImageConverter" />
      <local:StringToBrushConverter x:Key="StringToBrushConverter" />
      <local:StringToColorConverter x:Key="StringToColorConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>