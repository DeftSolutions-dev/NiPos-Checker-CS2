                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="NotifText_Title" Grid.Column="0" Text="Уведомления" FontFamily="{StaticResource Font_Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource WindowIconButton}" Width="26" Height="26" Click="CloseNotifications_Click">
                  <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                      <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Grid Name="NothingDetectedText" Visibility="Collapsed" Margin="15,14">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0" Background="{StaticResource Brush_MintFill}" BorderThickness="1" BorderBrush="#4D34D399">
                      <Viewbox Width="17" Height="17">
                        <Canvas Width="24" Height="24">
                          <Path Data="M12,3 L20,6 L20,12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 L4,6 M9,12 L11,14 L15,10" Stroke="{StaticResource Brush_Mint}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Ничего не обнаружено" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" />
                      <TextBlock Text="Фоновая проверка завершена." FontSize="11.5" Foreground="{StaticResource Brush_Dim}" Margin="0,3,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <ItemsControl Name="AutoDetectList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="0,0,0,1" BorderBrush="#B3242427" Padding="15,13">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Top" Background="{StaticResource Brush_AmberFill}" BorderThickness="1" BorderBrush="#4DF0A93C">
                            <Viewbox Width="17" Height="17">
                              <Canvas Width="24" Height="24">
                                <Path Data="M12,3 L3,20 L21,20 M12,10 L12,14 M12,17 L12.01,17" Stroke="{StaticResource Brush_Amber}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                              </Canvas>
                            </Viewbox>
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" Text="{Binding Title}" />
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Brush_Dim}" Margin="0,3,0,0" Text="{Binding Text}" />
                            <Button Style="{StaticResource PrimaryBtn}" Height="30" Margin="0,9,0,0" HorizontalAlignment="Left" Padding="14,0" Content="{Binding ActionLabel}" Tag="{Binding Id}" Visibility="{Binding ActionVisibility}" Click="AutoDetectAction_Click" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource Brush_Rail}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}">
          <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Text="CID" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
              <TextBlock Name="FooterCid" Margin="8,0,0,0" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Dim}" VerticalAlignment="Center" />
              <Border Width="6" Height="11" Margin="6,0,0,0" Background="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Ellipse Width="5" Height="5" Fill="{StaticResource Brush_Mint}" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock Text="СВЯЗЬ С СЕРВЕРОМ" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Mint}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Name="LinkWebsite" Cursor="Hand" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Dim}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,0" MouseLeftButtonDown="LinkWebsite_Click" />
              <TextBlock Name="LinkDiscord" Cursor="Hand" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Dim}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,0" MouseLeftButtonDown="LinkDiscord_Click" />
              <TextBlock Name="LinkVK" Cursor="Hand" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Dim}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,0" MouseLeftButtonDown="LinkVK_Click" />
              <TextBlock Name="FooterVersion" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>