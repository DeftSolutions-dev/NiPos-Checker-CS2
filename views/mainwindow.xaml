<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NIPOS CHECKER" Height="760" Width="1289" MinHeight="600" MinWidth="1040" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#00FFFFFF" AllowsTransparency="True" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border Name="RootBorder" BorderThickness="1" CornerRadius="14" BorderBrush="{StaticResource Brush_Line}" Background="{StaticResource Brush_WindowBg}" SizeChanged="RootBorder_SizeChanged">
    <Grid>
      <FrameworkElement.LayoutTransform>
        <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
      </FrameworkElement.LayoutTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Brush_Rail}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush_Line}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Padding="20,22,20,20" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}">
            <Grid>
              <Image Name="ProjectLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MaxHeight="52" HorizontalAlignment="Center" />
              <Grid Name="LogoSpinner" Width="40" Height="40" HorizontalAlignment="Center" Visibility="Collapsed">
                <Ellipse Width="40" Height="40" Stroke="{StaticResource Brush_Line2}" StrokeThickness="3.5" />
                <Ellipse Width="40" Height="40" Stroke="{StaticResource Brush_Brand}" StrokeThickness="3.5" StrokeDashArray="10 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                  <UIElement.RenderTransform>
                    <RotateTransform Angle="0" />
                  </UIElement.RenderTransform>
                  <FrameworkElement.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </FrameworkElement.Triggers>
                </Ellipse>
              </Grid>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,16,12,16">
            <StackPanel>
              <Grid Margin="10,0,10,9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ПРОВЕРКА" FontFamily="{StaticResource Font_Mono}" FontSize="9.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="1" Margin="9,0,0,0" VerticalAlignment="Center" Background="{StaticResource Brush_Line}" />
              </Grid>
              <RadioButton Style="{StaticResource MenuButton}" IsChecked="True" Tag="Search" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="01" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Search" Grid.Column="1" Text="Поиск файлов" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="USB" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="02" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_USB" Grid.Column="1" Text="USB Устройства" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="LastActivity" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="03" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_LastActivity" Grid.Column="1" Text="Последняя активность" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="Software" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="04" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Software" Grid.Column="1" Text="Программы" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="Registry" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="05" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Registry" Grid.Column="1" Text="Реестр ПК" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="Accounts" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="06" FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Steam" Grid.Column="1" Text="STEAM Аккаунты" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <Grid Margin="10,20,10,9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ДОПОЛНИТЕЛЬНО" FontFamily="{StaticResource Font_Mono}" FontSize="9.5" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="1" Margin="9,0,0,0" VerticalAlignment="Center" Background="{StaticResource Brush_Line}" />
              </Grid>
              <RadioButton Style="{StaticResource MenuButton}" Tag="Traces" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="·" FontFamily="{StaticResource Font_Mono}" FontSize="12" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Traces" Grid.Column="1" Text="Следы / Антиобход" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="Processes" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="·" FontFamily="{StaticResource Font_Mono}" FontSize="12" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Processes" Grid.Column="1" Text="Процессы / Инъекции" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="System" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="·" FontFamily="{StaticResource Font_Mono}" FontSize="12" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Other" Grid.Column="1" Text="Другое" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource MenuButton}" Tag="Renames" Checked="MenuTab_Checked">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="·" FontFamily="{StaticResource Font_Mono}" FontSize="12" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                  <TextBlock Name="MenuText_Renames" Grid.Column="1" Text="Переименованные файлы" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
            </StackPanel>
          </ScrollViewer>
          <Border Name="BannerPanel" Grid.Row="2" Visibility="Collapsed" Margin="14,4,14,10" CornerRadius="10" ClipToBounds="True" Cursor="Hand" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}" MouseLeftButtonDown="Banner_Click">
            <Grid>
              <Image Name="BannerImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel VerticalAlignment="Bottom" Margin="10,8">
                <TextBlock Name="BannerTextTop" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF" TextWrapping="Wrap" />
                <TextBlock Name="BannerTextLink" FontSize="10" Foreground="{StaticResource Brush_Brand}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="3" Padding="18,14,18,16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}">
            <StackPanel>
              <Grid Margin="0,4">
                <TextBlock Text="Сессия" FontSize="11.5" Foreground="{StaticResource Brush_Faint}" HorizontalAlignment="Left" />
                <TextBlock Name="SessionClock" Text="00:00:00" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Dim}" HorizontalAlignment="Right" />
              </Grid>
              <Grid Margin="0,4">
                <TextBlock Text="Профиль" FontSize="11.5" Foreground="{StaticResource Brush_Faint}" HorizontalAlignment="Left" />
                <TextBlock Text="Полная проверка" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Dim}" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="*" />
          <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Name="TabTitle" Text="Поиск файлов" Visibility="Collapsed" />
            <Button Style="{StaticResource WindowIconButton}" ToolTip="Уменьшить (Ctrl -)" Click="ZoomOut_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Ellipse Canvas.Left="4" Canvas.Top="4" Width="13" Height="13" StrokeThickness="1.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <Path Data="M20,20 L16.5,16.5 M7.5,10.5 L13.5,10.5" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource WindowIconButton}" ToolTip="Увеличить (Ctrl +)" Click="ZoomIn_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Ellipse Canvas.Left="4" Canvas.Top="4" Width="13" Height="13" StrokeThickness="1.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <Path Data="M20,20 L16.5,16.5 M7.5,10.5 L13.5,10.5 M10.5,7.5 L10.5,13.5" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource WindowIconButton}" ToolTip="Сбросить масштаб (Ctrl 0)" Click="ZoomReset_Click">
              <Viewbox Width="15" Height="15">
                <Canvas Width="24" Height="24">
                  <Path Data="M20,7 A8,8 0 1 0 20.5,14M20,7 L20,3 M20,7 L16,7" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Border Width="1" Height="16" Background="{StaticResource Brush_Line}" Margin="8,0" />
            <Button Name="BtnSound" Style="{StaticResource WindowIconButton}" ToolTip="Звук интерфейса вкл/выкл" Click="ToggleSound_Click">
              <Viewbox Name="SoundIcon" Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M11,5 L6,9 L3,9 L3,15 L6,15 L11,19 M15.5,8.5 A5,5 0 0 1 15.5,15.5" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Name="BtnNotif" Style="{StaticResource WindowIconButton}" ToolTip="Уведомления" Click="OpenNotifications_Click">
              <Grid>
                <Viewbox Width="16" Height="16">
                  <Canvas Width="24" Height="24">
                    <Path Data="M18,8 A6,6 0 1 0 6,8C6,15 3,16 3,16 L21,16 C21,16 18,15 18,8 M13.7,21 A2,2 0 0 1 10.299999999999999,21" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Canvas>
                </Viewbox>
                <Ellipse Name="NotificationRedDot" Width="6" Height="6" Fill="{StaticResource Brush_Brand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" Visibility="Collapsed">
                  <UIElement.Effect>
                    <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                  </UIElement.Effect>
                </Ellipse>
              </Grid>
            </Button>
            <Button Name="BtnSettings" Style="{StaticResource WindowIconButton}" ToolTip="Настройки" Click="Settings_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" StrokeThickness="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <Path Data="M19.4,15 A1.6,1.6 0 0 0 19.7,16.8L19.8,16.900000000000002 A2,2 0 1 1 17,19.700000000000003L16.9,19.6 A1.6,1.6 0 0 0 14.2,20.700000000000003L14.2,21 A2,2 0 1 1 10.2,21L10.2,20.9 A1.6,1.6 0 0 0 7.9,19L7.800000000000001,19.1 A2,2 0 1 1 5,16.3L5.1,16.2 A1.6,1.6 0 0 0 3.9999999999999996,13.5L3,13.5 A2,2 0 1 1 3,9.5L3.1,9.5 A1.6,1.6 0 0 0 5,7.9L4.9,7.8 A2,2 0 1 1 7.7,5L7.8,5.1 A1.6,1.6 0 0 0 10.5,3.9999999999999996L10.5,3 A2,2 0 1 1 14.5,3L14.5,3.1 A1.6,1.6 0 0 0 17.2,4.2L17.3,4.1000000000000005 A2,2 0 1 1 20.1,7L20,7.1 A1.6,1.6 0 0 0 21.1,9.8L21,9.8 A2,2 0 1 1 21,13.8L20.9,13.8 A1.6,1.6 0 0 0 19.4,15" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Name="BtnLanguage" Style="{StaticResource WindowIconButton}" ToolTip="Язык" Click="Language_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M4,5 L14,5 M9,3 L9,5 C9,10 6,13 3,14 M6,9 C6,12 9,15 13,16 M20,20 L24,11 L28,20 M14.5,17 L19.5,17" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Name="BtnReport" Style="{StaticResource WindowIconButton}" ToolTip="Отправить отчёт админу" Click="SendReport_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M12,16 L12,4 M8,8 L12,4 L16,8 M5,15 L5,18 A2,2 0 0 0 7,20L17,20 A2,2 0 0 0 19,18L19,15" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Name="BtnHistory" Style="{StaticResource WindowIconButton}" ToolTip="Прошлые проверки этого аккаунта" Click="History_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M12,21 A9,9 0 1 0 3.5,9M3,4 L3,8 L7,8 M12,7 L12,12 L15.5,14" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Border Width="1" Height="16" Background="{StaticResource Brush_Line}" Margin="8,0" />
            <Button Style="{StaticResource WindowIconButton}" ToolTip="Свернуть" Click="Minimize_Click">
              <Viewbox Width="14" Height="14">
                <Canvas Width="24" Height="24">
                  <Path Data="M5,12 L19,12" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Name="MaxRestoreBtn" Style="{StaticResource WindowIconButton}" ToolTip="Развернуть" Click="MaxRestore_Click">
              <Viewbox Width="12" Height="12">
                <Canvas Width="24" Height="24">
                  <Path Name="MaxRestorePath" Data="M5,5 L19,5 L19,19 L5,19" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource WindowCloseButton}" ToolTip="Закрыть" Margin="0,0,2,0" Click="ExitBtn_Click">
              <Viewbox Width="14" Height="14">
                <Canvas Width="24" Height="24">
                  <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
          </StackPanel>
        </Border>
        <Grid Row="1" Margin="30,24,30,22">
          <Grid Name="Tab_Search" Visibility="Visible">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Row="0" Margin="0,0,0,18">
              <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Ellipse Width="6" Height="6" Fill="{StaticResource Brush_Brand}" VerticalAlignment="Center" Margin="0,0,9,0">
                    <UIElement.Effect>
                      <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="8" ShadowDepth="0" />
                    </UIElement.Effect>
                  </Ellipse>
                  <TextBlock Text="ЭТАП 01 · ПОИСК ФАЙЛОВ" FontFamily="{StaticResource Font_Mono}" FontSize="10" Foreground="{StaticResource Brush_Faint}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Поиск файлов" FontFamily="{StaticResource Font_Sans}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" />
                <TextBlock Text="Сканирование дисков по сигнатурам, хешам и характерным путям. Игрок видит тот же результат, что и администратор." Foreground="{StaticResource Brush_Dim}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource GhostBtn}" Margin="0,0,9,0" Click="SelectSearchFolders_Click">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                      <Canvas Width="24" Height="24">
                        <Path Data="M3,7 A2,2 0 0 1 5,5L9,5 L11,7 L19,7 A2,2 0 0 1 21,9L21,17 A2,2 0 0 1 19,19L5,19 A2,2 0 0 1 3,17" StrokeThickness="1.6" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Name="BtnText_SelectFolders" Text="Выбрать папки" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Name="StartSearchBtn" Style="{StaticResource PrimaryBtn}" Click="StartSearch_Click">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                      <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="14" Height="14" Stroke="{DynamicResource Brush_BrandText}" StrokeThickness="1.7" />
                        <Path Data="M20,20 L16.4,16.4" Stroke="{DynamicResource Brush_BrandText}" StrokeThickness="1.7" StrokeStartLineCap="Round" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Name="BtnText_StartSearch" Text="Начать поиск" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Name="StopSearchBtn" Style="{StaticResource DangerBtn}" Visibility="Collapsed" Margin="9,0,0,0" Click="StopSearch_Click">
                  <TextBlock Name="BtnText_Stop" Text="Стоп" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>
            <Border Name="VerdictBorder" Grid.Row="1" Margin="0,0,0,18" CornerRadius="12" Background="{StaticResource Brush_Panel}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}" ClipToBounds="True">
              <Grid>
                <Grid Margin="20,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Name="VerdictLamp" Grid.Column="0" Width="42" Height="42" CornerRadius="11" Margin="0,0,20,0" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}">
                    <Viewbox Width="19" Height="19">
                      <Canvas Width="24" Height="24">
                        <Path Name="VerdictLampPath" Data="M21,12 A9,9 0 1 1 3,12A9,9 0 1 1 21,12M12,8 L12,13 M12,16 L12.01,16" Stroke="{StaticResource Brush_Faint}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                    </Viewbox>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="VerdictTitle" Text="Проверка не запускалась" FontFamily="{StaticResource Font_Sans}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" />
                    <TextBlock Name="VerdictSub" Text="Выберите папки или запустите поиск по всем дискам" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Name="VerdictNum" Text="—" FontFamily="{StaticResource Font_Sans}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Brush_Text}" HorizontalAlignment="Right" />
                    <TextBlock Name="VerdictCap" Text="СОВПАДЕНИЙ" FontFamily="{StaticResource Font_Mono}" FontSize="9.5" Foreground="{StaticResource Brush_Faint}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                  </StackPanel>
                </Grid>
