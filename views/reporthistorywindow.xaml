<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.ReportHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Height="460" Width="720" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" AllowsTransparency="True" ShowInTaskbar="False" MinHeight="280" MinWidth="480" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border CornerRadius="14" Background="{StaticResource Brush_Panel}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}" ClipToBounds="True">
    <UIElement.Effect>
      <DropShadowEffect Color="#FF000000" BlurRadius="40" ShadowDepth="12" Opacity="0.6" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Name="HeaderTitle" Text="История проверок" FontFamily="{StaticResource Font_Sans}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" />
            <TextBlock Name="SubTitle" Text="" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,3,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Width="30" Height="30" Click="Close_Click">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Canvas>
            </Viewbox>
          </Button>
        </Grid>
      </Border>
      <Grid Row="1">
        <TextBlock Name="OverlayText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font_Mono}" FontSize="12.5" Foreground="{StaticResource Brush_Faint}" TextAlignment="Center" Text="" />
        <Border Name="TableBox" Margin="16,14" CornerRadius="10" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}" ClipToBounds="True">
          <DataGrid Name="ItemsGrid" Style="{StaticResource DarkDataGrid}" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ДАТА" Width="150" Binding="{Binding DateDisplay}" />
              <DataGridTextColumn Header="ПРОЕКТ" Width="160" Binding="{Binding Project}" />
              <DataGridTextColumn Header="ВЕРДИКТ" Width="*" Binding="{Binding Verdict}" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}" Padding="18,14">
        <Grid>
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Faint}" Text="Вердикт выставляет администратор в панели проверок" />
          <Button Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Padding="22,0" Click="Close_Click">
            <TextBlock Text="Закрыть" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>