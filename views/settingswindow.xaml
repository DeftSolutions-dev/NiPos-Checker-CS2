<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Height="248" Width="420" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" AllowsTransparency="True" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border CornerRadius="14" Background="{StaticResource Brush_Panel}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}" ClipToBounds="True">
    <UIElement.Effect>
      <DropShadowEffect Color="#FF000000" BlurRadius="40" ShadowDepth="12" Opacity="0.6" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="HeaderTitle" Grid.Column="0" Text="Настройки" FontFamily="{StaticResource Font_Sans}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Width="30" Height="30" Click="Close_Click">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Canvas>
            </Viewbox>
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="18,18,18,4">
        <CheckBox Name="SoundCheck" Style="{StaticResource DarkCheckBox}" Content="Звук интерфейса" Checked="Sound_Changed" Unchecked="Sound_Changed" />
        <Grid Margin="0,20,0,10">
          <TextBlock Text="Громкость" FontSize="12.5" Foreground="{StaticResource Brush_Dim}" HorizontalAlignment="Left" />
          <TextBlock Name="VolumeLabel" FontFamily="{StaticResource Font_Mono}" FontSize="12.5" Foreground="{StaticResource Brush_Text}" HorizontalAlignment="Right" />
        </Grid>
        <Slider Name="VolumeSlider" Style="{StaticResource RedSlider}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Volume_Changed" />
      </StackPanel>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}" Padding="18,14">
        <Button Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Padding="22,0" Click="Close_Click">
          <TextBlock Name="CloseText" Text="Закрыть" VerticalAlignment="Center" />
        </Button>
      </Border>
    </Grid>
  </Border>
</Window>