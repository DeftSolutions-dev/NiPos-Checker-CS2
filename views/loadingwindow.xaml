<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.LoadingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NiposChecker" Title="NIPOS CHECKER" Height="440" Width="640" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="#00FFFFFF" xmlns:views="clr-namespace:NiposChecker.Views">
  <Border CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}">
    <Border.Background>
      <RadialGradientBrush GradientOrigin="0.5,0.36" Center="0.5,0.36" RadiusX="0.8" RadiusY="0.7">
        <GradientStop Color="{DynamicResource Clr_BrandFillSoft}" Offset="0" />
        <GradientStop Color="#FF08080A" Offset="0.6" />
        <GradientStop Color="#FF08080A" Offset="1" />
      </RadialGradientBrush>
    </Border.Background>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Name="SplashLogo" Stretch="Uniform" MaxHeight="96" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" Margin="0,0,0,22" HorizontalAlignment="Center" />
      <Grid Name="SplashSpinner" Width="66" Height="66" Margin="0,0,0,22" HorizontalAlignment="Center">
        <Ellipse Width="66" Height="66" Stroke="{StaticResource Brush_Line2}" StrokeThickness="4" />
        <Ellipse Width="66" Height="66" Stroke="{StaticResource Brush_Brand}" StrokeThickness="4" StrokeDashArray="14 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
          <UIElement.Effect>
            <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="12" ShadowDepth="0" Opacity="0.7" />
          </UIElement.Effect>
          <UIElement.RenderTransform>
            <RotateTransform Angle="0" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </Ellipse>
      </Grid>
      <TextBlock Name="VersionText" Text="{x:Static local:Config.Version}" Foreground="{StaticResource Brush_Dim}" FontFamily="{StaticResource Font_Mono}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,22" />
      <Border Width="360" Height="5" CornerRadius="3" Background="{StaticResource Brush_Panel2}" HorizontalAlignment="Center" ClipToBounds="True">
        <Border Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource Brush_Brand}">
          <UIElement.Effect>
            <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
          </UIElement.Effect>
        </Border>
      </Border>
      <ProgressBar Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="0" Visibility="Collapsed" ValueChanged="ProgressBar_ValueChanged" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
        <TextBlock Name="StatusText" Text="Инициализация…" Foreground="{StaticResource Brush_Faint}" FontFamily="{StaticResource Font_Mono}" FontSize="11.5" />
        <TextBlock Name="PercentText" Text="0%" Foreground="{StaticResource Brush_Brand}" FontFamily="{StaticResource Font_Mono}" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>