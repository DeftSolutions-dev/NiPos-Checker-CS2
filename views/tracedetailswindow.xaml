<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.TraceDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Height="440" Width="680" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" AllowsTransparency="True" ShowInTaskbar="False" MinHeight="260" MinWidth="440" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border CornerRadius="14" Background="{StaticResource Brush_Panel}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}" ClipToBounds="True">
    <UIElement.Effect>
      <DropShadowEffect Color="#FF000000" BlurRadius="40" ShadowDepth="12" Opacity="0.6" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="HeaderTitle" Grid.Column="0" Text="" FontFamily="{StaticResource Font_Sans}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Width="30" Height="30" Click="Close_Click">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Canvas>
            </Viewbox>
          </Button>
        </Grid>
      </Border>
      <Border Grid.Row="1" Margin="16,14" CornerRadius="10" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}" ClipToBounds="True">
        <DataGrid Name="ItemsGrid" Style="{StaticResource DarkDataGrid}" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="Grid_DoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="ColName" Header="ПРОГРАММА" Width="170" Binding="{Binding Name}" />
            <DataGridTextColumn x:Name="ColPath" Header="ПУТЬ" Width="*" Binding="{Binding Path}" />
            <DataGridTextColumn x:Name="ColRun" Header="ПОСЛЕДНИЙ ЗАПУСК" Width="150" Binding="{Binding LastRun}" />
            <DataGridTextColumn x:Name="ColExtra1" Header="" Width="150" Binding="{Binding Extra1}" />
            <DataGridTextColumn x:Name="ColExtra2" Header="" Width="150" Binding="{Binding Extra2}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}" Padding="18,14">
        <Grid>
          <TextBlock Name="HintText" VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Faint}" />
          <Button Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Padding="22,0" Click="Close_Click">
            <TextBlock Name="CloseText" Text="Закрыть" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>