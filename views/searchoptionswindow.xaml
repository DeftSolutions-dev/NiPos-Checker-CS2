<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.SearchOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Режим поиска" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" Background="#00FFFFFF" AllowsTransparency="True" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_Drag">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ModeButton" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" CornerRadius="10" Padding="14,12" BorderThickness="1" Background="{StaticResource Brush_Panel2}" BorderBrush="{StaticResource Brush_Line}">
                <Grid>
                  <ContentPresenter VerticalAlignment="Center" />
                  <Ellipse Name="dot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Fill="{StaticResource Brush_Brand}">
                    <UIElement.Effect>
                      <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="8" ShadowDepth="0" />
                    </UIElement.Effect>
                  </Ellipse>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Line2}" />
                </Trigger>
                <Trigger Property="FrameworkElement.Tag" Value="picked">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Brand}" />
                  <Setter TargetName="bd" Value="{DynamicResource Brush_BrandFillDim}" Property="Border.Background" />
                  <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border CornerRadius="14" Background="{StaticResource Brush_Panel}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}" ClipToBounds="True">
    <UIElement.Effect>
      <DropShadowEffect Color="#FF000000" BlurRadius="44" ShadowDepth="14" Opacity="0.6" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="ModeTitle" Grid.Column="0" Text="Режим поиска" FontFamily="{StaticResource Font_Sans}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Width="30" Height="30" Click="Cancel_Click">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Canvas>
            </Viewbox>
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="18,18,18,6">
        <Button Name="ModeFast" Style="{StaticResource ModeButton}" Click="FastSearch_Click">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M13,2 L4,14 L10,14 L9,22 L18,10 L12,10" Stroke="{StaticResource Brush_Dim}" StrokeThickness="1.7" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <StackPanel>
              <TextBlock Name="FastText" Text="Быстрый поиск" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Brush_Text}" />
              <TextBlock Text="Downloads, Desktop, Documents, AppData" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button Name="ModeSystem" Style="{StaticResource ModeButton}" Click="SystemSearch_Click">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M3,4 L21,4 L21,16 L3,16 M8,20 L16,20 M12,16 L12,20" Stroke="{StaticResource Brush_Dim}" StrokeThickness="1.7" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <StackPanel>
              <TextBlock Name="SysText" Text="Системный диск" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Brush_Text}" />
              <TextBlock Text="Полная проверка всех папок диска C:" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button Name="ModeManual" Style="{StaticResource ModeButton}" Click="ManualSearch_Click">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M4,6 L11,6 L11,11 L4,11 M13,6 L20,6 L20,11 L13,11 M4,14 L11,14 L11,18 L4,18 M13,14 L20,14 L20,18 L13,18" Stroke="{StaticResource Brush_Dim}" StrokeThickness="1.7" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <StackPanel>
              <TextBlock Name="ManualText" Text="Выбор дисков вручную" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Brush_Text}" />
              <TextBlock Text="Отметить нужные локальные диски" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button Name="ModeFolder" Style="{StaticResource ModeButton}" Click="BrowseFolder_Click">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M3,7 A2,2 0 0 1 5,5L9,5 L11,7 L19,7 A2,2 0 0 1 21,9L21,17 A2,2 0 0 1 19,19L5,19 A2,2 0 0 1 3,17" Stroke="{StaticResource Brush_Dim}" StrokeThickness="1.7" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <StackPanel>
              <TextBlock Name="BrowseText" Text="Выбрать папку…" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Brush_Text}" />
              <TextBlock Text="Добавить конкретные папки к проверке" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Border CornerRadius="10" Padding="14,14,14,16" Margin="0,8,0,0" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}">
          <StackPanel>
            <TextBlock Name="MethodsTitle" Text="МЕТОДЫ ПРОВЕРКИ" FontFamily="{StaticResource Font_Mono}" FontSize="10" Foreground="{StaticResource Brush_Faint}" Margin="0,0,0,11" />
            <CheckBox Name="IconMatchCheck" Style="{StaticResource DarkCheckBox}" Content="По иконке (медленнее)" Margin="0,0,0,9" />
            <CheckBox Name="SignatureMatchCheck" Style="{StaticResource DarkCheckBox}" Content="По цифровой подписи" />
          </StackPanel>
        </Border>
        <TextBlock Name="SelFoldersTitle" Text="ВЫБРАННЫЕ ПАПКИ" FontFamily="{StaticResource Font_Mono}" FontSize="10" Foreground="{StaticResource Brush_Faint}" Margin="2,16,0,8" />
        <Border CornerRadius="10" MinHeight="60" Padding="12,10" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}">
          <Grid>
            <TextBlock Name="FoldersPlaceholder" Text="Папки не выбраны" FontFamily="{StaticResource Font_Mono}" FontSize="11.5" Foreground="{StaticResource Brush_Faint}" />
            <ItemsControl Name="SelectedFoldersList" />
          </Grid>
        </Border>
        <StackPanel Name="DrivePanel" Visibility="Collapsed" Margin="0,12,0,0">
          <TextBlock Name="DrivesTitle" Text="ВЫБЕРИТЕ ДИСКИ" FontFamily="{StaticResource Font_Mono}" FontSize="10" Foreground="{StaticResource Brush_Faint}" Margin="2,0,0,8" />
          <ItemsControl Name="DriveList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Style="{StaticResource DarkCheckBox}" Margin="2,2" IsChecked="{Binding IsSelected}" Content="{Binding DisplayText}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}" Padding="18,14">
        <Grid>
          <TextBlock Name="StatusLabel" FontSize="11.5" Foreground="{StaticResource Brush_Mint}" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostBtn}" Padding="20,0" Margin="0,0,9,0" Click="Cancel_Click">
              <TextBlock Name="CancelText" Text="Отмена" VerticalAlignment="Center" />
            </Button>
            <Button Name="OkBtn" Style="{StaticResource PrimaryBtn}" Padding="26,0" IsEnabled="False" Click="Ok_Click">
              <TextBlock Text="ОК" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>