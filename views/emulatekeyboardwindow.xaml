<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.EmulateKeyboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Проверка в игре" Height="260" Width="500" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FF151516" AllowsTransparency="True" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown" Closing="Window_Closing">
  <Border CornerRadius="12" BorderThickness="1" BorderBrush="#FF37373C" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#FF1D1D1F">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="HeaderTitle" Grid.Column="0" Text="Автоматическая проверка в игре" FontFamily="{StaticResource Font_Montserrat}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush_TextMain}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Grid.Column="1" Content="✕" Width="34" Height="34" Foreground="{DynamicResource Brush_Brand}" Cursor="Hand" BorderThickness="0" Background="#00FFFFFF" FontSize="14" Click="Close_Click" />
      </Grid>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <TextBlock Name="DescText" Text="Нажимает все клавиши в окне CS2.&#xA;Если макрос привязан к клавише — он сработает." FontSize="12" Foreground="{StaticResource Brush_TextDim}" TextAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" />
        <Button Name="StartBtn" Style="{StaticResource GreenButton}" Height="44" Padding="24,0" HorizontalAlignment="Center" Click="StartCheck_Click">
          <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/icons/crosshair.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9" />
            <TextBlock Name="StartText" Text="Начать проверку" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0" Width="360">
          <TextBlock Name="ProgressText" Text="0/0" HorizontalAlignment="Center" Foreground="{StaticResource Brush_NeonBlue}" FontSize="13" FontFamily="Consolas" Margin="0,0,0,6" />
          <ProgressBar Name="ProgressBar" Height="6" Value="0" Maximum="100" Foreground="{StaticResource Brush_NeonBlue}" Background="#FF242427" BorderThickness="0" />
        </StackPanel>
        <TextBlock Name="ResultText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush_Green}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Grid>
  </Border>
</Window>