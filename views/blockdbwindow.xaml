<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.BlockDbWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BlockDB — проверка банов" Height="640" Width="980" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" AllowsTransparency="True" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="BdbAccItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="bd" CornerRadius="7" Background="#00FFFFFF" Padding="10,9">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_Panel}" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_BrandFill}" />
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Brand}" />
                  <Setter TargetName="bd" Property="Border.BorderThickness" Value="2,0,0,0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border CornerRadius="14" Background="{StaticResource Brush_Panel}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}" ClipToBounds="True">
    <UIElement.Effect>
      <DropShadowEffect Color="#FF000000" BlurRadius="48" ShadowDepth="16" Opacity="0.6" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="HeaderTitle" Grid.Column="0" Text="BlockDB — проверка банов" FontFamily="{StaticResource Font_Sans}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Width="30" Height="30" Click="Close_Click">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.7" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Canvas>
            </Viewbox>
          </Button>
        </Grid>
      </Border>
      <Grid Row="1" Margin="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Name="AccountsHeader" Grid.Row="0" Text="АККАУНТЫ" FontFamily="{StaticResource Font_Mono}" FontSize="10" Foreground="{StaticResource Brush_Brand}" Margin="0,0,0,9" />
          <Border Grid.Row="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,9" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}">
            <Grid>
              <TextBlock Name="ProgressLabel" Text="Проверка…" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Dim}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
              <TextBlock Name="ProgressCount" Text="0/0" FontFamily="{StaticResource Font_Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush_Brand}" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <Border Grid.Row="2" CornerRadius="10" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}" ClipToBounds="True">
            <ListBox Name="AccountsList" Background="#00FFFFFF" BorderThickness="0" Padding="6" ItemContainerStyle="{StaticResource BdbAccItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AccountsList_SelectionChanged">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{Binding DotBrush}" />
                    <StackPanel>
                      <TextBlock FontFamily="{StaticResource Font_Sans}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Brush_Text}" TextTrimming="CharacterEllipsis" Text="{Binding Nickname}" />
                      <TextBlock FontFamily="{StaticResource Font_Mono}" FontSize="10" Margin="0,2,0,0" Text="{Binding BanSummary}" Foreground="{Binding SummaryBrush}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
        <Grid Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Name="BanDetailHeader" Grid.Row="0" Text="ДЕТАЛИ БАНА" FontFamily="{StaticResource Font_Mono}" FontSize="10" Foreground="{StaticResource Brush_Brand}" Margin="0,0,0,9" />
          <Border Grid.Row="1" CornerRadius="10" Background="{StaticResource Brush_Panel2}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}" ClipToBounds="True">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <ItemsControl Name="BansGrid">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,10" CornerRadius="10" Padding="14" Background="{StaticResource Brush_Panel}" BorderThickness="3,1,1,1" Opacity="{Binding CardOpacity}" BorderBrush="{Binding BanLeftBrush}">
                        <StackPanel>
                          <Grid>
                            <Border CornerRadius="5" Padding="9,4" HorizontalAlignment="Left" Background="{Binding BanTagFill}">
                              <TextBlock FontFamily="{StaticResource Font_Mono}" FontSize="10.5" FontWeight="Medium" Text="{Binding BanTagText}" Foreground="{Binding BanTagBrush}" />
                            </Border>
                            <TextBlock FontFamily="{StaticResource Font_Mono}" FontSize="10.5" Foreground="{StaticResource Brush_Faint}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding IssuedText}" />
                          </Grid>
                          <TextBlock FontFamily="{StaticResource Font_Sans}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" TextWrapping="Wrap" Margin="0,9,0,0" Text="{Binding Reason}" />
                          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Проект:" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,0,5,0" />
                            <TextBlock FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Dim}" Margin="0,0,14,0" Text="{Binding ProjectName}" />
                            <TextBlock Text="IP:" FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Faint}" Margin="0,0,5,0" />
                            <TextBlock FontFamily="{StaticResource Font_Mono}" FontSize="11" Foreground="{StaticResource Brush_Dim}" Text="{Binding UserIp}" />
                          </StackPanel>
                          <Border Margin="0,9,0,0" Padding="0,9,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}" Visibility="{Binding NoteVisibility}">
                            <TextBlock FontFamily="{StaticResource Font_Mono}" FontSize="11.5" Text="{Binding NoteText}" Foreground="{Binding NoteBrush}" />
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Name="NoBansLabel" Visibility="Collapsed" Background="{StaticResource Brush_Panel2}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Viewbox Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Canvas Width="24" Height="24">
                      <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="{StaticResource Brush_Mint}" StrokeThickness="1.6" />
                      <Path Data="M8,12 L11,15 L16,9" Stroke="{StaticResource Brush_Mint}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="Банов не найдено" FontFamily="{StaticResource Font_Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" HorizontalAlignment="Center" />
                  <TextBlock Text="По этому аккаунту записей в BlockDB нет" FontSize="12" Foreground="{StaticResource Brush_Faint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}" Padding="18,14">
        <Button Name="CloseBtn" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Padding="22,0" Content="Закрыть" Click="Close_Click" />
      </Border>
    </Grid>
  </Border>
</Window>