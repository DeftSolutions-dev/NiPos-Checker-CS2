<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.FirstLaunchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Height="300" Width="420" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="#00FFFFFF" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="LangOption" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="50" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" CornerRadius="10" Padding="16,0" BorderThickness="1" Background="{StaticResource Brush_Panel2}" BorderBrush="{StaticResource Brush_Line2}">
                <Grid>
                  <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                  <Viewbox Name="chk" Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                    <Canvas Width="24" Height="24">
                      <Path Data="M5,12 L10,17 L19,7" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{StaticResource Brush_Brand}" />
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Faint}" />
                </Trigger>
                <Trigger Property="FrameworkElement.Tag" Value="active">
                  <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Brand}" />
                  <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_BrandFill}" />
                  <Setter TargetName="chk" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border CornerRadius="14" Background="{StaticResource Brush_Panel}" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}" ClipToBounds="True">
    <UIElement.Effect>
      <DropShadowEffect Color="#FF000000" BlurRadius="40" ShadowDepth="12" Opacity="0.6" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush_Line}" Padding="18,16">
        <TextBlock Name="StepTitle" FontFamily="{StaticResource Font_Sans}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush_Text}" VerticalAlignment="Center" />
      </Border>
      <Grid Row="1" Margin="18">
        <StackPanel Name="LangStep" VerticalAlignment="Center">
          <Button Name="RuBtn" Style="{StaticResource LangOption}" Margin="0,0,0,10" Click="Ru_Click">
            <TextBlock Name="RuText" />
          </Button>
          <Button Name="EnBtn" Style="{StaticResource LangOption}" Click="En_Click">
            <TextBlock Name="EnText" />
          </Button>
        </StackPanel>
        <StackPanel Name="SettingsStep" VerticalAlignment="Center" Visibility="Collapsed">
          <CheckBox Name="SoundCheck" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,18" IsChecked="True" />
          <CheckBox Name="DiscordCheck" Style="{StaticResource DarkCheckBox}" IsChecked="True" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush_Line}" Padding="18,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="BackBtn" Style="{StaticResource GhostBtn}" Height="38" Padding="20,0" Margin="0,0,10,0" Visibility="Collapsed" Click="Back_Click">
            <TextBlock Name="BackText" VerticalAlignment="Center" />
          </Button>
          <Button Name="NextBtn" Style="{StaticResource PrimaryBtn}" Height="38" Padding="24,0" Click="Next_Click">
            <TextBlock Name="NextText" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>