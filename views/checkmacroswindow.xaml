<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NiposChecker.Views.CheckMacrosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Проверка на макросы" Height="500" Width="700" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FF151516" AllowsTransparency="True" xmlns:views="clr-namespace:NiposChecker.Views;assembly=NiposChecker" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border CornerRadius="12" BorderThickness="1" BorderBrush="#FF37373C" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#FF1D1D1F">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="HeaderTitle" Grid.Column="0" Text="Проверка на макросы" FontFamily="{StaticResource Font_Montserrat}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush_TextMain}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Grid.Column="1" Content="✕" Width="34" Height="34" Foreground="{DynamicResource Brush_Brand}" Cursor="Hand" BorderThickness="0" Background="#00FFFFFF" FontSize="14" Click="Close_Click" />
      </Grid>
      <Border Grid.Row="1" Margin="12,8,12,8" CornerRadius="8" Background="#22000000" BorderThickness="1" BorderBrush="#FF242427">
        <Canvas Name="DrawingCanvas" Background="#00FFFFFF" ClipToBounds="True" MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp" MouseLeave="Canvas_MouseLeave" />
      </Border>
      <Border Grid.Row="2" Background="#FF1D1D1F" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="ColorLabel" Text="Цвет:" Foreground="{StaticResource Brush_TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Rectangle Name="ClrWhite" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FFFFFFFF" Stroke="#44FFFFFF" StrokeThickness="1" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonDown="Color_White" />
            <Rectangle Name="ClrRed" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FFFF0000" Stroke="#00FFFFFF" StrokeThickness="1" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonDown="Color_Red" />
            <Rectangle Name="ClrYellow" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FFFFFF00" Stroke="#00FFFFFF" StrokeThickness="1" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonDown="Color_Yellow" />
            <Rectangle Name="ClrGreen" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FF90EE90" Stroke="#00FFFFFF" StrokeThickness="1" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonDown="Color_Green" />
            <Rectangle Name="ClrCyan" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FFF0FFFF" Stroke="#00FFFFFF" StrokeThickness="1" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonDown="Color_Cyan" />
            <Rectangle Name="ClrBlue" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FF0000FF" Stroke="#00FFFFFF" StrokeThickness="1" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonDown="Color_Blue" />
            <Rectangle Name="ClrPurple" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#FF9370DB" Stroke="#00FFFFFF" StrokeThickness="1" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonDown="Color_Purple" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="TplCs2Btn" Style="{StaticResource BlueButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Content="" Click="Template_CS2_Click" />
            <Button Name="TplModelsBtn" Style="{StaticResource BlueButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Content="" Click="Template_Models_Click" />
          </StackPanel>
          <Button Name="ClearBtn" Grid.Column="2" Style="{StaticResource RedButton}" Height="32" Padding="12,0" Content="" Click="ClearCanvas_Click" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>