  <SolidColorBrush x:Key="Brush_Amber" Color="{StaticResource Clr_Amber}" />
  <SolidColorBrush x:Key="Brush_Mint" Color="{StaticResource Clr_Mint}" />
  <SolidColorBrush x:Key="Brush_BrandFill" Color="{DynamicResource Clr_BrandFill}" />
  <SolidColorBrush x:Key="Brush_MintFill" Color="#1F34D399" />
  <SolidColorBrush x:Key="Brush_AmberFill" Color="#24F0A93C" />
  <SolidColorBrush x:Key="Brush_BrandTag" Color="{DynamicResource Clr_BrandTag}" />
  <SolidColorBrush x:Key="Brush_MintTag" Color="#FF5FE0B4" />
