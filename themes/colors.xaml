  <Color x:Key="Clr_BrandLine">#66FF283F</Color>
  <Color x:Key="Clr_BrandLineSoft">#59FF283F</Color>
  <Color x:Key="Clr_BrandLineHard">#80FF283F</Color>
  <Color x:Key="Clr_BrandText">#FFFFFFFF</Color>
  <Color x:Key="Clr_Gold">#FFF4CA80</Color>
  <Color x:Key="Clr_Amber">#FFF0A93C</Color>
  <Color x:Key="Clr_Mint">#FF34D399</Color>
  <SolidColorBrush x:Key="Brush_Ink" Color="{StaticResource Clr_Ink}" />
  <SolidColorBrush x:Key="Brush_Rail" Color="{StaticResource Clr_Rail}" />
  <SolidColorBrush x:Key="Brush_Panel2" Color="{StaticResource Clr_Panel2}" />
  <SolidColorBrush x:Key="Brush_Line" Color="{StaticResource Clr_Line}" />
  <SolidColorBrush x:Key="Brush_Line2" Color="{StaticResource Clr_Line2}" />
  <SolidColorBrush x:Key="Brush_Text" Color="{StaticResource Clr_Text}" />
  <SolidColorBrush x:Key="Brush_Dim" Color="{StaticResource Clr_Dim}" />
  <SolidColorBrush x:Key="Brush_Faint" Color="{StaticResource Clr_Faint}" />
  <SolidColorBrush x:Key="Brush_Brand" Color="{DynamicResource Clr_Brand}" />
  <SolidColorBrush x:Key="Brush_BrandSoft" Color="{DynamicResource Clr_BrandSoft}" />
  <SolidColorBrush x:Key="Brush_BrandHover" Color="{DynamicResource Clr_BrandHover}" />
