  <SolidColorBrush x:Key="Brush_CardHover" Color="{StaticResource Clr_Panel2}" />
  <SolidColorBrush x:Key="Brush_Panel" Color="{StaticResource Clr_Panel}" />
  <SolidColorBrush x:Key="Brush_Sidebar" Color="{StaticResource Clr_Rail}" />
  <SolidColorBrush x:Key="Brush_Footer" Color="{StaticResource Clr_Faint}" />
  <SolidColorBrush x:Key="Brush_FooterBright" Color="{StaticResource Clr_Dim}" />
  <SolidColorBrush x:Key="Brush_Border" Color="{StaticResource Clr_Line}" />
  <SolidColorBrush x:Key="Brush_BorderBlue" Color="{StaticResource Clr_Line2}" />
  <RadialGradientBrush x:Key="Brush_WindowBg" GradientOrigin="0.8,-0.08" Center="0.8,-0.08" RadiusX="0.95" RadiusY="0.8">
    <GradientStop Color="{DynamicResource Clr_BrandGlow}" Offset="0" />
    <GradientStop Offset="0.55" Color="{StaticResource Clr_Ink}" />
    <GradientStop Offset="1" Color="{StaticResource Clr_Ink}" />
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="Brush_MenuActive" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="{DynamicResource Clr_BrandFillSoft}" Offset="0" />
    <GradientStop Offset="1" Color="{StaticResource Clr_Panel2}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush_BlueButton" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{DynamicResource Clr_Brand}" Offset="0" />
    <GradientStop Color="{DynamicResource Clr_Brand}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush_GreenButton" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{DynamicResource Clr_Brand}" Offset="0" />
    <GradientStop Color="{DynamicResource Clr_Brand}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush_RedButton" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{DynamicResource Clr_Brand}" Offset="0" />
    <GradientStop Color="{DynamicResource Clr_Brand}" Offset="1" />
  </LinearGradientBrush>
