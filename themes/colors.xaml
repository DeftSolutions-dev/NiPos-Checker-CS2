  <FontFamily x:Key="Font_Motiva">pack://application:,,,/Assets/fonts/#IBM Plex Sans</FontFamily>
  <Color x:Key="Clr_Ink">#FF0A0A0B</Color>
  <Color x:Key="Clr_Rail">#FF0C0C0D</Color>
