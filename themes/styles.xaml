<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <CubicEase x:Key="EaseOutUI" EasingMode="EaseOut" />
  <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource Brush_BrandText}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="glow" CornerRadius="10" Opacity="0" Background="{StaticResource Brush_Brand}">
              <UIElement.Effect>
                <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="20" ShadowDepth="0" Opacity="1" />
              </UIElement.Effect>
            </Border>
            <Border Name="bd" CornerRadius="10" Padding="{TemplateBinding Control.Padding}" BorderThickness="1" Background="{StaticResource Brush_Brand}" BorderBrush="{StaticResource Brush_Brand}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_BrandHover}" />
              <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_BrandHover}" />
              <Setter TargetName="glow" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_BrandSoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GhostBtn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource Brush_Dim}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="bd" CornerRadius="10" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderThickness="1" BorderBrush="{StaticResource Brush_Line2}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_Panel2}" />
              <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Faint}" />
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_Line}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DangerBtn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource Brush_BrandTag}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="bd" CornerRadius="10" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderThickness="1" BorderBrush="{DynamicResource Brush_BrandLineSoft}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource Brush_BrandFillSoft}" Property="Border.Background" />
              <Setter TargetName="bd" Value="{DynamicResource Brush_Brand}" Property="Border.BorderBrush" />
              <Setter Value="{DynamicResource Brush_BrandTag}" Property="Foreground" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NvidiaBtn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource Brush_Mint}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="bd" CornerRadius="10" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderThickness="1" BorderBrush="#4D34D399">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="#1A34D399" />
              <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Mint}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BlueButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryBtn}" />
  <Style x:Key="GreenButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryBtn}" />
  <Style x:Key="RedButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerBtn}" />
  <Style x:Key="WindowIconButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource Brush_Faint}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Mono}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="bd" Background="{TemplateBinding Control.Background}" CornerRadius="7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_Panel2}" />
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WindowCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowIconButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="bd" Background="#00FFFFFF" CornerRadius="7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_Brand}" />
              <Setter Property="Foreground" Value="{StaticResource Brush_BrandText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MenuButton" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush_Dim}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="2" Visibility="Collapsed" Background="{StaticResource Brush_Brand}">
              <UIElement.Effect>
                <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
              </UIElement.Effect>
            </Border>
            <Border Name="bg" CornerRadius="10" Background="#00FFFFFF" Padding="8,0,10,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Border.Background" Value="{StaticResource Brush_Panel}" />
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="bg" Property="Border.Background" Value="{StaticResource Brush_MenuActive}" />
              <Setter TargetName="bar" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ChipToggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush_Dim}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="bd" CornerRadius="10" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderThickness="1" BorderBrush="{StaticResource Brush_Line}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
              <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Line2}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_Panel2}" />
              <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Line2}" />
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SearchBox" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource Brush_Brand}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="bd" CornerRadius="10" BorderThickness="1" Padding="12,0" Background="{StaticResource Brush_Panel}" BorderBrush="{StaticResource Brush_Line}">
            <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Line2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border CornerRadius="4" Margin="2" Background="{StaticResource Brush_Line2}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource DarkScrollThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10" />
              <Setter Property="Width" Value="Auto" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ColumnHeaderGripper" TargetType="{x:Type Thumb}">
    <Setter Property="Width" Value="12" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="{TemplateBinding Control.Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkDataGrid" TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="{StaticResource Brush_Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="DataGrid.RowBackground" Value="#00FFFFFF" />
    <Setter Property="DataGrid.AlternatingRowBackground" Value="#00FFFFFF" />
    <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal" />
    <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#B3242427" />
    <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
    <Setter Property="DataGrid.AutoGenerateColumns" Value="False" />
    <Setter Property="DataGrid.IsReadOnly" Value="True" />
    <Setter Property="DataGrid.CanUserAddRows" Value="False" />
    <Setter Property="DataGrid.CanUserResizeRows" Value="False" />
    <Setter Property="DataGrid.CanUserResizeColumns" Value="True" />
    <Setter Property="DataGrid.CanUserReorderColumns" Value="True" />
    <Setter Property="DataGrid.SelectionMode" Value="Single" />
    <Setter Property="DataGrid.RowHeight" Value="40" />
    <Setter Property="DataGrid.ColumnHeaderHeight" Value="34" />
    <Setter Property="DataGrid.EnableRowVirtualization" Value="True" />
    <Setter Property="DataGrid.ColumnHeaderStyle">
      <Setter.Value>
        <Style TargetType="{x:Type DataGridColumnHeader}">
          <Setter Property="Background" Value="{StaticResource Brush_Panel2}" />
          <Setter Property="Foreground" Value="{StaticResource Brush_Dim}" />
          <Setter Property="FontFamily" Value="{StaticResource Font_Mono}" />
          <Setter Property="FontWeight" Value="Medium" />
          <Setter Property="FontSize" Value="9.5" />
          <Setter Property="Height" Value="34" />
          <Setter Property="Padding" Value="16,0,0,0" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
          <Setter Property="BorderBrush" Value="{StaticResource Brush_Line2}" />
          <Setter Property="DataGridColumnHeader.SeparatorVisibility" Value="Collapsed" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                <Grid>
                  <Border Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <Thumb Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripper}" />
                  <Thumb Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripper}" />
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="DataGrid.RowStyle">
      <Setter.Value>
        <Style TargetType="{x:Type DataGridRow}">
          <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Style.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource Brush_Panel2}" />
            </Trigger>
            <Trigger Property="DataGridRow.IsSelected" Value="True">
              <Setter Property="Background" Value="{StaticResource Brush_Panel2}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="DataGrid.CellStyle">
      <Setter.Value>
        <Style TargetType="{x:Type DataGridCell}">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="16,0,0,0" />
          <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type DataGridCell}">
                <Border Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="DataGridCell.IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ProgramButton" TargetType="{x:Type Button}">
    <Setter Property="Margin" Value="0,0,0,7" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="bd" CornerRadius="10" Padding="13,11" BorderThickness="1" Background="{StaticResource Brush_Panel}" BorderBrush="{StaticResource Brush_Line}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Border.Background" Value="{StaticResource Brush_Panel2}" />
              <Setter TargetName="bd" Property="Border.BorderBrush" Value="{StaticResource Brush_Line2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SoftwareCard" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostBtn}" />
  <Style x:Key="ActionCard" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostBtn}" />
  <Style x:Key="RedSlider" TargetType="{x:Type Slider}">
    <Setter Property="Height" Value="16" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid VerticalAlignment="Center">
            <Border Height="4" CornerRadius="3" Background="{StaticResource Brush_Panel2}" />
            <Track Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Height="4" CornerRadius="3" Background="{StaticResource Brush_Brand}" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Ellipse Width="16" Height="16" Stroke="#FF15151A" StrokeThickness="2" Fill="{StaticResource Brush_Brand}">
                        <UIElement.Effect>
                          <DropShadowEffect Color="{DynamicResource Clr_Brand}" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                        </UIElement.Effect>
                      </Ellipse>
                    </ControlTemplate>
                  </Control.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkCheckBox" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{StaticResource Brush_Dim}" />
    <Setter Property="FontFamily" Value="{StaticResource Font_Sans}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="#00FFFFFF">
            <Border Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="1" Background="{StaticResource Brush_Panel2}" BorderBrush="{StaticResource Brush_Line2}">
              <Viewbox Name="check" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Canvas Width="24" Height="24">
                  <Path Data="M5,12 L10,17 L19,7" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{StaticResource Brush_BrandText}" />
                </Canvas>
              </Viewbox>
            </Border>
            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="box" Property="Border.Background" Value="{StaticResource Brush_Brand}" />
              <Setter TargetName="box" Property="Border.BorderBrush" Value="{StaticResource Brush_Brand}" />
              <Setter TargetName="check" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource Brush_Text}" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="box" Property="Border.BorderBrush" Value="{StaticResource Brush_Faint}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>